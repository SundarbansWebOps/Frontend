VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_61O0mgCXVAInGq2DhoInOQ_Z4nj8b4r

# Retired (old Apps Script login); members now sign in with Google through Supabase Auth.
VITE_GOOGLE_CLIENT_ID=109050287811-iv9lqr9e6eg5goavml3s05tsh6qgtrk9.apps.googleusercontent.com

# Apps Script /exec URL that checks membership by email (Sheet yes/no).
# Required for login (dev and production). Without it, login shows a config error.
