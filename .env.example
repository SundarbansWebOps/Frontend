# Cloudinary (server-side scripts only — media:sync / media:migrate-repo).
# Not needed for vite build/dev. Get keys from cloudinary.com dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
